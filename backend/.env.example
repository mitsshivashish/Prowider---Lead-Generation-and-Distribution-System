# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/prowider_db"

# Admin Credentials (MUST be set in production - change default values!)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION"
ADMIN_TOKEN="generate-a-cryptographically-secure-token-here"

# Provider Authentication Secret (MUST be set in production)
PROVIDER_AUTH_SECRET="generate-a-cryptographically-secure-secret-here"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Server Configuration
NODE_ENV="development"
PORT=3001
