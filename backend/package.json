{
  "name": "prowider-backend",
  "version": "1.0.0",
  "description": "Prowider Lead Distribution Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:migrate-providers": "tsx prisma/migrate-provider-auth.ts",
    "prisma:migrate-completion": "tsx prisma/migrate-provider-lead-completion.ts",
    "prisma:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.20.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "pg": "^8.20.0",
    "typescript": "^5.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "tsx": "^4.7.0",
  }
}
