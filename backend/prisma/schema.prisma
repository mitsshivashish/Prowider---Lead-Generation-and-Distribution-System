// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  
  leads     Lead[]
  mandatoryRules MandatoryRule[]
  fairAllocationPools FairAllocationPool[]
}

model Provider {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  monthlyQuota    Int       @default(10)
  quotaResetDate  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  
  assignedLeads   ProviderLead[]
  webhookCalls    WebhookCall[]
}

model Lead {
  id            Int       @id @default(autoincrement())
  name          String
  email         String?
  phoneNumber   String
  city          String
  serviceId     Int
  service       Service   @relation(fields: [serviceId], references: [id])
  description   String
  budget        String?
  serviceDate   String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  
  assignedProviders ProviderLead[]
  
  @@unique([phoneNumber, serviceId])
}

model ProviderLead {
  id                    Int       @id @default(autoincrement())
  providerId            Int
  provider              Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  leadId                Int
  lead                  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedAt            DateTime  @default(now())
  status                String    @default("assigned") // assigned, pending_customer_confirmation, completed, disputed
  completionNote        String?
  completionRequestedAt DateTime?
  completedAt           DateTime?
  completionToken        String?   @unique
  completionTokenExpires DateTime?
  
  @@unique([providerId, leadId])
  @@index([providerId])
  @@index([leadId])
  @@index([status])
}

model MandatoryRule {
  id        Int       @id @default(autoincrement())
  serviceId Int
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId Int
  createdAt DateTime  @default(now())
  
  @@unique([serviceId, providerId])
  @@index([serviceId])
}

model FairAllocationPool {
  id                    Int       @id @default(autoincrement())
  serviceId             Int
  service               Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId            Int
  lastAllocatedLeadId   Int?
  allocationCount       Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@unique([serviceId, providerId])
  @@index([serviceId])
}

model WebhookCall {
  id            String    @id @default(cuid())
  providerId    Int
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  idempotencyKey String
  action        String    // "reset_quota"
  status        String    @default("pending") // pending, completed
  createdAt     DateTime  @default(now())
  
  @@unique([providerId, idempotencyKey])
  @@index([providerId])
}
